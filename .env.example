# Server-side only. Never prefix these with NEXT_PUBLIC_ — they must not
# reach the browser bundle. /api/ask-adam is the only place that should
# read them.

# Optional OpenAI-compatible chat-completions endpoint. Without these values,
# Ask Adam remains fully usable and returns deterministic retrieved summaries.
ASK_ADAM_LLM_ENDPOINT=
ASK_ADAM_LLM_API_KEY=
ASK_ADAM_LLM_MODEL=
